# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Server Configuration
PORT=5000

# JWT Secrets
JWT_SECRET=your_jwt_secret_here
CUSTOMER_JWT_SECRET=your_customer_jwt_secret_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URLs (for CORS and Password Reset Links)
CLIENT_URL=https://sneha-bazar.vercel.app
# ADMIN_URL=https://sneha-bazar-admin.vercel.app
# ALLOWED_ORIGINS=https://sneha-bazar.vercel.app,https://sneha-bazar-admin.vercel.app

# Email Provider Configuration (Gmail SMTP with App Password for testing, or Transactional SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASSWORD=your-google-app-password
EMAIL_FROM=Sneha Bazar <your-gmail-address@gmail.com>

# Alternative: Resend REST API (Production)
# RESEND_API_KEY=re_your_api_key_here

# Optional: SMS OTP Provider Configuration (Optional / if enabled)
# OTP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid